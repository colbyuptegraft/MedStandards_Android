<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MedStandarts_v2" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/airForce</item>
        <item name="colorPrimaryVariant">@color/airForce</item>
        <item name="colorOnPrimary">@color/airForce</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/airForce</item>
        <item name="colorSecondaryVariant">@color/airForce</item>
        <item name="colorOnSecondary">@color/airForce</item>


    </style>

    <style name="WhiteActionBarTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:textColorPrimary">#FFFFFF</item> <!-- Text color -->
        <item name="android:textColorSecondary">#FFFFFF</item> <!-- Subtitle color -->
        <item name="android:textColorHint">#DDDDDD</item> <!-- Hint color in SearchView -->
        <item name="android:colorControlNormal">#FFFFFF</item> <!-- Icon color -->
        <item name="android:colorControlActivated">#FFFFFF</item> <!-- Color of active icons -->
        <item name="android:colorControlHighlight">#FFFFFF</item> <!-- Color of clicks -->
    </style>



</resources>