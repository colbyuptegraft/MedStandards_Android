        android:layout_marginEnd="100dp"
        android:enabled="true"
        android:gravity="center|center_vertical"
        app:fb_backgroundColor="#fff"
        app:fb_cornerRadius="10dp"
        app:fb_shadow="15dp"
        app:fb_shape="rectangle"
        app:fb_text="Basic"
        app:fb_textColor="#000"
        app:fb_textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline"
        tools:ignore="TouchTargetSizeCheck" >

    </com.github.nikartm.button.FitButton>

    -->

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/img" />

    <!-- SUBSCRIPTION DISABLED - Price text commented out
    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="50dp"
        android:text="$0.99"
        android:textSize="34sp"
        android:textColor="#fff"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonAbout" />
    -->

    <!-- SUBSCRIPTION DISABLED - Monthly text commented out
    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
