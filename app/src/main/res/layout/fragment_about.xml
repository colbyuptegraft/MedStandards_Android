<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <com.github.nikartm.button.FitButton
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:enabled="true"
        android:gravity="center|center_vertical"
        app:fb_backgroundColor="#000"
        app:fb_cornerRadius="30dp"
        app:fb_shape="rectangle"
        app:fb_text="Download PDF"
        app:fb_textColor="#fff"
        app:fb_textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="TouchTargetSizeCheck" />

    <com.github.nikartm.button.FitButton
        android:id="@+id/buttonSubs"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:enabled="true"
        android:gravity="center|center_vertical"
        app:fb_backgroundColor="#000"
        app:fb_cornerRadius="30dp"
        app:fb_shape="rectangle"
        app:fb_text="Subscription plan"
        app:fb_textColor="#fff"
        app:fb_textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button"
        tools:ignore="TouchTargetSizeCheck" />

    <com.github.nikartm.button.FitButton
        android:id="@+id/buttonAbout"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:enabled="true"
        android:gravity="center|center_vertical"
        app:fb_backgroundColor="#000"
        app:fb_cornerRadius="30dp"
        app:fb_shape="rectangle"
        app:fb_text="About"
        app:fb_textColor="#fff"
        app:fb_textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonSubs"
        tools:ignore="TouchTargetSizeCheck" />


</androidx.constraintlayout.widget.ConstraintLayout>